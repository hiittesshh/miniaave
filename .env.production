# Production build settings (Vercel production + preview builds, and local `next build`).
# Committed on purpose: none of these is a secret (NEXT_PUBLIC_* values end up in the browser
# bundle anyway). Never put keys or tokens in this file. Values set in the Vercel dashboard win.

# Every page outside /mini redirects to /mini (next.config.ts), so the Aave look-alike pages are
# never served publicly.
MINI_ONLY=1

# Chain mode reads Base Sepolia when no wallet is connected (otherwise it defaults to local anvil).
NEXT_PUBLIC_MINI_CHAIN_ID=84532

# Visitors start on mock data; the chip next to the wordmark switches to the real contracts.
NEXT_PUBLIC_MINI_SOURCE=mock
